#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    //  flavor = "tap-preferred";
    // tapping_term_ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        letters {
            bindings = <
&kp Q         &kp W      &kp F  &kp P  &kp B    &kp J  &kp L  &kp U      &kp Y          &kp SEMICOLON
&kp A         &kp R      &kp S  &kp T  &kp G    &kp M  &kp N  &kp E      &kp I          &kp O
&mt LSHIFT Z  &kp X      &kp C  &kp D  &kp V    &kp K  &kp H  &kp COMMA  &kp DOT        &mt RSHIFT SLASH
&mo 2         &kp SPACE                                                  &kp BACKSPACE  &mo 1
            >;
        };

        numbers {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &kp NUMBER_6  &kp N7  &kp N8  &kp N9  &kp N0
&trans        &trans        &trans        &trans        &trans    &trans        &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans    &trans        &trans  &trans  &trans  &trans
&trans        &kp ENTER                                                                         &trans  &trans
            >;
        };

        symbols {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans
&trans  &trans                                                    &kp DELETE  &trans
            >;
        };

        system {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans          &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &bt BT_CLR      &studio_unlock  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans          &trans          &trans  &trans  &trans  &trans
&trans        &trans                                                                                    &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        condition {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
